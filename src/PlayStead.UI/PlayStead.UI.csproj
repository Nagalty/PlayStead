<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\Geist\Geist-Regular.ttf" />
    <None Remove="Assets\Fonts\Geist\Geist-SemiBold.ttf" />
    <None Remove="Assets\Fonts\Geist\Geist-Bold.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-Regular.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-Bold.ttf" />
    <None Update="Assets\Fonts\Geist\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayStead.Core\PlayStead.Core.csproj" />
    <ProjectReference Include="..\PlayStead.Data\PlayStead.Data.csproj" />
    <ProjectReference Include="..\PlayStead.Platform\PlayStead.Platform.csproj" />
    <ProjectReference Include="..\PlayStead.Providers\PlayStead.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
