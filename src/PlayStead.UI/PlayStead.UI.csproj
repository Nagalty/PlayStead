<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Branding\PlayStead.ico</ApplicationIcon>
    <PlaySteadProductVersion Condition="'$(PlaySteadProductVersion)' == ''">0.4.1-dev</PlaySteadProductVersion>
    <AssemblyInformationalVersion>$(PlaySteadProductVersion)</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version Condition="'$(Version)' == ''">$(PlaySteadProductVersion)</Version>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <PlaySteadDistributionChannel Condition="'$(PlaySteadDistributionChannel)' == ''">GitHub</PlaySteadDistributionChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlaySteadDistributionChannel</_Parameter1>
      <_Parameter2>$(PlaySteadDistributionChannel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\PlayStead.Updater\bin\$(Configuration)\net10.0\PlayStead.Updater.exe')">
    <ItemGroup>
      <UpdaterPayload Include="$(MSBuildProjectDirectory)\..\PlayStead.Updater\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterPayload)" DestinationFiles="@(UpdaterPayload->'$(TargetDir)UpdaterHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\Geist\Geist-Regular.ttf" />
    <None Remove="Assets\Fonts\Geist\Geist-SemiBold.ttf" />
    <None Remove="Assets\Fonts\Geist\Geist-Bold.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-Regular.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Geist\Geist-Bold.ttf" />
    <None Remove="Assets\Home\HomeHeroIdle01.png" />
    <None Remove="Assets\Home\HomeHeroIdle02.png" />
    <None Remove="Assets\Home\HomeHeroIdle03.png" />
    <None Remove="Assets\Home\HomeHeroIdle04.png" />
    <Resource Include="Assets\Home\HomeHeroIdle01.png" />
    <Resource Include="Assets\Home\HomeHeroIdle02.png" />
    <Resource Include="Assets\Home\HomeHeroIdle03.png" />
    <Resource Include="Assets\Home\HomeHeroIdle04.png" />
    <None Remove="Assets\Branding\playstead-logo-horizontal.png" />
    <Resource Include="Assets\Branding\playstead-logo-horizontal.png" />
    <None Remove="Assets\Branding\PlayStead.ico" />
    <Resource Include="Assets\Branding\PlayStead.ico" />
    <None Update="Assets\Fonts\Geist\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayStead.Core\PlayStead.Core.csproj" />
    <ProjectReference Include="..\PlayStead.Data\PlayStead.Data.csproj" />
    <ProjectReference Include="..\PlayStead.Platform\PlayStead.Platform.csproj" />
    <ProjectReference Include="..\PlayStead.Providers\PlayStead.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
