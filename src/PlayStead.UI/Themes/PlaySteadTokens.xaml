<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         PLAYSTEAD — AUTHORITATIVE COLOR PALETTE
         Reference: approved Home / Game Detail mockups
         ========================================================= -->

    <!-- Base surfaces -->
    <SolidColorBrush x:Key="PlayStead.Brush.Background" Color="#0B1117"/>
    <SolidColorBrush x:Key="PlayStead.Brush.Surface" Color="#111A23"/>
    <SolidColorBrush x:Key="PlayStead.Brush.SurfaceRaised" Color="#17222D"/>
    <SolidColorBrush x:Key="PlayStead.Brush.SurfaceHover" Color="#1D2A36"/>
    <SolidColorBrush x:Key="PlayStead.Brush.SurfaceSubtle" Color="#141D26"/>
    <SolidColorBrush x:Key="PlayStead.Brush.SurfaceStrong" Color="#202C38"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="PlayStead.Brush.Border" Color="#273441"/>
    <SolidColorBrush x:Key="PlayStead.Brush.BorderStrong" Color="#364554"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PlayStead.Brush.TextPrimary" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="PlayStead.Brush.TextSecondary" Color="#A9B3C1"/>
    <SolidColorBrush x:Key="PlayStead.Brush.TextMuted" Color="#718092"/>
    <SolidColorBrush x:Key="PlayStead.Brush.TextSoft" Color="#D7DEE7"/>

    <!-- Primary accent -->
    <Color x:Key="PlayStead.Color.Copper">#F28A3A</Color>
    <SolidColorBrush x:Key="PlayStead.Brush.Copper"
                     Color="{StaticResource PlayStead.Color.Copper}"/>
    <SolidColorBrush x:Key="PlayStead.Brush.CopperHover" Color="#FF9B4A"/>
    <SolidColorBrush x:Key="PlayStead.Brush.CopperPressed" Color="#D97025"/>

    <!-- Semantic states -->
    <SolidColorBrush x:Key="PlayStead.Brush.Success" Color="#26D98B"/>
    <SolidColorBrush x:Key="PlayStead.Brush.Warning" Color="#F4B740"/>
    <SolidColorBrush x:Key="PlayStead.Brush.Danger" Color="#FF5D57"/>
    <SolidColorBrush x:Key="PlayStead.Brush.Info" Color="#4AA3FF"/>
    <SolidColorBrush x:Key="PlayStead.Brush.Purple" Color="#8B63E6"/>

    <!-- Semantic icon roles -->
    <SolidColorBrush x:Key="PlayStead.Brush.IconPrimary" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="PlayStead.Brush.IconMuted" Color="#718092"/>
    <SolidColorBrush x:Key="PlayStead.Brush.IconAccent"
                     Color="{StaticResource PlayStead.Color.Copper}"/>


    <!-- Scrollbar -->
    <SolidColorBrush x:Key="PlayStead.Brush.ScrollTrack"
                     Color="#00000000"/>
    <SolidColorBrush x:Key="PlayStead.Brush.ScrollThumb"
                     Color="#536678"/>
    <SolidColorBrush x:Key="PlayStead.Brush.ScrollThumbHover"
                     Color="{StaticResource PlayStead.Color.Copper}"/>

    <!-- Spacing -->
    <Thickness x:Key="PlayStead.Spacing.1">4</Thickness>
    <Thickness x:Key="PlayStead.Spacing.2">8</Thickness>
    <Thickness x:Key="PlayStead.Spacing.3">16</Thickness>
    <Thickness x:Key="PlayStead.Spacing.4">24</Thickness>
    <Thickness x:Key="PlayStead.Spacing.5">32</Thickness>
    <Thickness x:Key="PlayStead.Spacing.6">48</Thickness>

    <!-- Radius -->
    <CornerRadius x:Key="PlayStead.Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="PlayStead.Radius.Medium">12</CornerRadius>
    <CornerRadius x:Key="PlayStead.Radius.Large">16</CornerRadius>

    <!-- Motion -->
    <Duration x:Key="PlayStead.Duration.Fast">0:0:0.120</Duration>
    <Duration x:Key="PlayStead.Duration.Normal">0:0:0.180</Duration>

    <!-- Typography -->
    <FontFamily x:Key="PlayStead.Font.Body">Segoe UI Variable, Segoe UI</FontFamily>

</ResourceDictionary>
