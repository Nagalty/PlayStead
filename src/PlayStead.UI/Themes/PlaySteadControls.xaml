<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PlayStead.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="2" StrokeThickness="2" StrokeDashArray="2,2"
                               Stroke="{DynamicResource PlayStead.Brush.TextPrimary}"
                               IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayStead.ControlBase" TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Spacing.2}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PlayStead.FocusVisual}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.CopperHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Copper}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.ProgressBar.Startup" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <StreamGeometry x:Key="PlayStead.Icon.Play">M 1,0 L 11,6 1,12 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.External">M 4,3 H 11 V 10 M 11,3 L 4,10 M 8,10 H 3 V 5</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Grid">M 3,3 H 9 V 9 H 3 Z M 11,3 H 17 V 9 H 11 Z M 3,11 H 9 V 17 H 3 Z M 11,11 H 17 V 17 H 11 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.List">M 3,3 H 5 V 5 H 3 Z M 8,4 H 18 M 3,9 H 5 V 11 H 3 Z M 8,10 H 18 M 3,15 H 5 V 17 H 3 Z M 8,16 H 18</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Verify">M 17,7 A 7,7 0 0 0 5,5 L 3,8 M 3,4 V 8 H 7 M 7,17 A 7,7 0 0 0 19,19 L 21,16 M 21,20 V 16 H 17</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.History">M 3,10 A 9,9 0 1 1 5,17 M 3,10 H 8 M 12,6 V 12 L 16,14</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Gamepad">M 6,4 C 3,4 2,6 1.5,9 L 0.7,14 C 0.4,16.5 2.5,18 4.2,16.5 L 7,14 H 17 L 19.8,16.5 C 21.5,18 23.6,16.5 23.3,14 L 22.5,9 C 22,6 21,4 18,4 Z M 5,7 V 11 M 3,9 H 7 M 16,8 A 1,1 0 1 0 18,8 A 1,1 0 1 0 16,8 M 19,11 A 1,1 0 1 0 21,11 A 1,1 0 1 0 19,11</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.ChevronRight">M 8,4 L 14,10 L 8,16</StreamGeometry>
    <!-- Microsoft Fluent System Icons (MIT), semantic mappings for PlayStead Shell. -->
    <StreamGeometry x:Key="PlayStead.Icon.Home">M 10,2 L 2,8 V 18 H 7 V 12 H 13 V 18 H 18 V 8 Z M 10,4.5 L 16,9 V 16 H 14 V 10 H 6 V 16 H 4 V 9 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Library">M 2,4 C 5,3 8,3 10,5 V 18 C 8,16 5,16 2,17 Z M 18,4 C 15,3 12,3 10,5 V 18 C 12,16 15,16 18,17 Z M 4,7 C 6,7 8,7 10,8 M 16,7 C 14,7 12,7 10,8</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Report">M 4,2 H 18 L 14,7 L 18,12 H 4 V 21 H 2 V 2 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Attention">M 4,2 H 18 L 14,7 L 18,12 H 4 V 21 H 2 V 2 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Bell">M 3,10 H 11 M 4,10 V 6 A 3,3 0 0 1 10,6 V 10 M 6,12 H 8</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Settings">M 8,1 H 12 L 13,4 A 7,7 0 0 1 15,5 L 18,4 L 20,8 L 17,10 A 7,7 0 0 1 17,12 L 20,14 L 18,18 L 15,17 A 7,7 0 0 1 13,18 L 12,21 H 8 L 7,18 A 7,7 0 0 1 5,17 L 2,18 L 0,14 L 3,12 A 7,7 0 0 1 3,10 L 0,8 L 2,4 L 5,5 A 7,7 0 0 1 7,4 Z M 8,8 A 3,3 0 1 0 14,8 A 3,3 0 1 0 8,8</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Search">M 9,2 A 7,7 0 1 0 9,16 A 7,7 0 1 0 9,2 M 14,14 L 19,19</StreamGeometry>
    <StreamGeometry x:Key="PlayStead.Icon.Info">M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 10,8 V 14 M 10,5 V 6</StreamGeometry>

    <Style x:Key="PlayStead.Icon.Navigation" TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource PlayStead.Brush.IconPrimary}"/>
        <Setter Property="Stroke" Value="{DynamicResource PlayStead.Brush.IconPrimary}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="Stroke" Value="{DynamicResource PlayStead.Brush.Accent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Semantic text roles. Pages choose a role; they do not redefine its scale. -->
    <Style x:Key="PlayStead.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Display}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.30}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.26}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.17}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.15}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.14}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.BodySecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.13}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.12}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="PlayStead.Text.ButtonLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.14}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="PlayStead.Text.PrimaryButtonLabel" TargetType="TextBlock" BasedOn="{StaticResource PlayStead.Text.ButtonLabel}">
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.16}"/>
    </Style>
    <Style x:Key="PlayStead.Text.Technical" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.13}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="PlayStead.Surface.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PlayStead.Radius.Medium}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Inset.Card}"/>
    </Style>
    <Style x:Key="PlayStead.Surface.Card" TargetType="Border" BasedOn="{StaticResource PlayStead.Surface.Panel}"/>
    <Style x:Key="PlayStead.Surface.CardNested" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceNested}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PlayStead.Radius.Small}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Spacing.2}"/>
    </Style>
    <Style x:Key="PlayStead.Surface.Metric" TargetType="Border" BasedOn="{StaticResource PlayStead.Surface.CardNested}"/>
    <Style x:Key="PlayStead.Surface.Selected" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PlayStead.Radius.Medium}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Inset.Card}"/>
    </Style>
    <Style x:Key="PlayStead.Status.Badge.Neutral" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PlayStead.Radius.Small}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Spacing.1}"/>
    </Style>
    <Style x:Key="PlayStead.Status.Badge.Success" TargetType="Border" BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}"><Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Success}"/></Style>
    <Style x:Key="PlayStead.Status.Badge.Warning" TargetType="Border" BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}"><Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Warning}"/></Style>
    <Style x:Key="PlayStead.Status.Badge.Error" TargetType="Border" BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}"><Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Error}"/></Style>
    <Style x:Key="PlayStead.Status.Badge.Info" TargetType="Border" BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}"><Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Info}"/></Style>

    <ControlTemplate x:Key="PlayStead.ButtonTemplate" TargetType="ButtonBase">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="PlayStead.NavigationTemplate" TargetType="Button">
        <Grid ClipToBounds="False">
            <Border x:Name="BackgroundBorder"
                    Grid.Row="0"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="KeyboardFocusCue"
                    Grid.Row="0"
                    Margin="1"
                    BorderBrush="{DynamicResource PlayStead.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusCue" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PlayStead.ButtonBase"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ControlBase}">
        <Setter Property="MinHeight" Value="{DynamicResource PlayStead.Control.Height}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Control.Padding}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Sans}"/>
        <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.14}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PlayStead.FocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource PlayStead.ButtonTemplate}"/>
    </Style>

    <Style x:Key="PlayStead.Button.Primary"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentHover}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.AccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Emphasis}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.BorderStrong}"/>
                <Setter Property="Opacity" Value="0.72"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.Button.Secondary"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.BorderStrong}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Emphasis}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextMuted}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.Button.Ghost"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Emphasis}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextMuted}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.Button.MediaAction"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextMuted}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.Button.Icon"
           TargetType="Button"
           BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Width" Value="{DynamicResource PlayStead.Control.IconSize}"/>
        <Setter Property="Height" Value="{DynamicResource PlayStead.Control.IconSize}"/>
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Control.IconPadding}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.IconMuted}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.IconPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Emphasis}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.IconMuted}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlayStead.Button.Navigation" TargetType="Button" BasedOn="{StaticResource PlayStead.ButtonBase}">
        <Setter Property="Padding" Value="{DynamicResource PlayStead.Control.Padding}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource PlayStead.NavigationTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource PlayStead.Button.Secondary}"/>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource PlayStead.ControlBase}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource PlayStead.ButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Copper}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keep native editing, selection, popup and keyboard behavior. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource PlayStead.ControlBase}">
        <Setter Property="CaretBrush" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PlayStead.Brush.Copper}"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource PlayStead.ControlBase}"/>
</ResourceDictionary>
