<UserControl x:Class="PlayStead.UI.Controls.KpiCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14"
            Background="#1D2024"
            BorderBrush="#30343A"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Foreground="#8F969F"
                       FontSize="12"/>

            <TextBlock Margin="0,5,0,0"
                       Text="{Binding Value, ElementName=Root}"
                       Foreground="#F2F4F7"
                       FontSize="20"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</UserControl>
