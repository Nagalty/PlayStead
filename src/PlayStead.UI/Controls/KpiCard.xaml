<UserControl x:Class="PlayStead.UI.Controls.KpiCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="{DynamicResource PlayStead.Spacing.3}"
            Background="{DynamicResource PlayStead.Brush.Surface}"
            BorderBrush="{DynamicResource PlayStead.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
        <StackPanel>
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Style="{DynamicResource PlayStead.Text.Caption}"/>

            <TextBlock Margin="0,5,0,0"
                       Text="{Binding Value, ElementName=Root}"
                       Style="{DynamicResource PlayStead.Text.Display}"/>
        </StackPanel>
    </Border>
</UserControl>
