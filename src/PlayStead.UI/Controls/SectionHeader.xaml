<UserControl x:Class="PlayStead.UI.Controls.SectionHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock Text="{Binding Title, ElementName=Root}"
               Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
               FontFamily="{DynamicResource PlayStead.Font.Body}"
               FontSize="17"
               FontWeight="SemiBold"/>
</UserControl>
