<UserControl x:Class="PlayStead.UI.Controls.PlaySplitButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="IsEnabled" Value="{Binding CanPlay, FallbackValue=False}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSessionActive, ElementName=Root}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button Content="Jouer"
                Click="Play_OnClick"
                IsEnabled="{Binding CanPlay, FallbackValue=False}"
                MinWidth="{Binding PrimaryButtonMinWidth, ElementName=Root}"
                Padding="{Binding PrimaryButtonPadding, ElementName=Root}"
                Background="#8D623E"
                Foreground="{DynamicResource PlayStead.Brush.TextPrimary}">
            <Button.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding PlayLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </DataTemplate>
            </Button.ContentTemplate>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="IsEnabled"
                            Value="{Binding CanPlay, FallbackValue=False}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSessionActive, ElementName=Root}"
                                     Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceStrong}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.BorderStrong}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="▾" Margin="2,0,0,0" Padding="10,10"
                ToolTip="Choisir une installation"
                AutomationProperties.Name="Choisir une installation"
                Visibility="{Binding HasMultipleLaunchOptions, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="Options_OnClick">
            <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             ItemsSource="{Binding LaunchOptions}">
                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding InstallPath}"/>
                            <EventSetter Event="Click" Handler="Installation_OnClick"/>
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </StackPanel>
</UserControl>
