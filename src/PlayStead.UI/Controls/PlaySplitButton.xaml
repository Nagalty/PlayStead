<UserControl x:Class="PlayStead.UI.Controls.PlaySplitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button Content="Jouer"
                IsEnabled="{Binding CanPlay, FallbackValue=False}"
                Click="Play_OnClick"
                Padding="14,10"
                Background="#8D623E"
                Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"/>
        <Button Content="▾" Margin="2,0,0,0" Padding="10,10"
                ToolTip="Choisir une installation"
                Visibility="{Binding HasMultipleLaunchOptions, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="Options_OnClick">
            <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             ItemsSource="{Binding LaunchOptions}">
                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding InstallPath}"/>
                            <EventSetter Event="Click" Handler="Installation_OnClick"/>
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </StackPanel>
</UserControl>
