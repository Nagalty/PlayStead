<UserControl x:Class="PlayStead.UI.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Width="260"
             Margin="0,0,12,12"
             Background="Transparent"
             MouseLeftButtonUp="GameCard_OnMouseLeftButtonUp">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="#1D2024"
            BorderBrush="#30343A"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="144" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="MediaFallback"
                    Grid.Row="0"
                    Background="#23272C"
                    BorderBrush="#30343A"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    ClipToBounds="True">
                <controls:GameArtwork SourcePath="{Binding CoverPath}"
                                      Title="{Binding Title}"
                                      ProviderLabel="{Binding ProviderLabel}"
                                      HasArtwork="{Binding HasCover}" />
            </Border>

            <Grid Grid.Row="1"
                  Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Foreground="#F2F4F7"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="1"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ProviderLabel}"
                               Foreground="#A9AFB7"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding InstalledSizeLabel, Mode=OneWay}"
                               Foreground="#7F8791"
                               FontSize="12" />
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <controls:StatusBadge Text="{Binding SessionStatusLabel}"
                                          Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border Margin="8,0,0,0"
                            Padding="8,3"
                            Background="#25292E"
                            BorderBrush="#3A3F46"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SteamStatusLabel}"
                                   Foreground="#D7B08C"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Text="{Binding InstallPath}"
                           Foreground="#6F7780"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
