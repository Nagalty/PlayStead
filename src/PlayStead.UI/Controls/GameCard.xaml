<UserControl x:Class="PlayStead.UI.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             xmlns:steam="clr-namespace:PlayStead.Core.Steam;assembly=PlayStead.Core"
             Width="220"
             Margin="0,0,12,12"
             Background="Transparent"
             MouseLeftButtonUp="GameCard_OnMouseLeftButtonUp"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="Library.SteamStatusBadge"
               TargetType="Border"
               BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}">
            <Setter Property="Visibility"
                    Value="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SteamState}" Value="{x:Static steam:SteamUpdateState.Unknown}">
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceSubtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Library.SteamStatusText"
               TargetType="TextBlock"
               BasedOn="{StaticResource PlayStead.Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SteamState}" Value="{x:Static steam:SteamUpdateState.Unknown}">
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextMuted}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="CardLift" Y="0" />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift"
                                     Storyboard.TargetProperty="Y"
                                     To="-4"
                                     Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:0.14" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardLift"
                                     Storyboard.TargetProperty="Y"
                                     To="0"
                                     Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.18" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Border x:Name="CardShell" Style="{DynamicResource PlayStead.Surface.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="MediaFallback"
                        Grid.Row="0"
                        Margin="-16,-16,-16,0"
                        Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                        ClipToBounds="True">
                    <Border.OpacityMask>
                        <VisualBrush Stretch="Fill">
                            <VisualBrush.Visual>
                                <Border Width="218"
                                        Height="316"
                                        Background="Black"
                                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>

                    <Grid>
                        <controls:GameArtwork SourcePath="{Binding CoverPath}"
                                              Title="{Binding Title}"
                                              ProviderLabel="{Binding ProviderLabel}"
                                              HasArtwork="{Binding HasCover}"
                                              MouseDoubleClick="GameArtwork_OnMouseDoubleClick" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,10,0"
                                Padding="6"
                                Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                                BorderBrush="{DynamicResource PlayStead.Brush.Copper}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                ToolTip="{Binding ProtectionBadgeTooltip}"
                                Visibility="{Binding IsLocallyProtected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Width="16"
                                  Height="18"
                                  Stretch="Uniform"
                                  Data="M10,1 L18,4 V9 C18,14 14,18 10,20 C6,18 2,14 2,9 V4 Z"
                                  Stroke="{DynamicResource PlayStead.Brush.Copper}"
                                  StrokeThickness="1.8"
                                  Fill="Transparent"
                                  AutomationProperties.Name="Protégé par PlayStead" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}"
                               Style="{DynamicResource PlayStead.Text.CardTitle}"
                               ToolTip="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="1"
                          Margin="{DynamicResource PlayStead.Gap.Block.Small}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding ProviderLabel}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{Binding InstalledSizeLabel, Mode=OneWay}"
                                   Style="{DynamicResource PlayStead.Text.Caption}" />
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                Orientation="Horizontal">
                        <controls:StatusBadge Text="{Binding SessionStatusLabel}"
                                              Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Margin="8,0,0,0"
                                Style="{DynamicResource Library.SteamStatusBadge}">
                            <TextBlock Text="{Binding SteamStatusLabel}"
                                       Style="{DynamicResource Library.SteamStatusText}" />
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <Border x:Name="HoverBorder"
                BorderBrush="{DynamicResource PlayStead.Brush.Copper}"
                BorderThickness="1"
                CornerRadius="8"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource PlayStead.Color.Copper}"
                                  ShadowDepth="0"
                                  BlurRadius="18"
                                  Opacity="0.30" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>
