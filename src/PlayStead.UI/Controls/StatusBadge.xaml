<UserControl x:Class="PlayStead.UI.Controls.StatusBadge"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource PlayStead.Status.Badge.Neutral}">
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                   FontFamily="{DynamicResource PlayStead.Font.Body}"
                   FontSize="12"
                   FontWeight="SemiBold"/>
    </Border>
</UserControl>
