<UserControl x:Class="PlayStead.UI.Controls.StatusBadge"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="8,3"
            Background="#2B211A"
            BorderBrush="#8D623E"
            BorderThickness="1"
            CornerRadius="5">
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   Foreground="#D7B08C"
                   FontSize="12"
                   FontWeight="SemiBold"/>
    </Border>
</UserControl>
