<UserControl x:Class="PlayStead.UI.Sessions.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             xmlns:sessions="clr-namespace:PlayStead.UI.Sessions"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SessionsHeading"
                       Grid.Row="0"
                       Text="Sessions"
                       Foreground="#F2F4F7"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="ActiveSessionsHeading"
                       Grid.Row="2"
                       Text="Sessions en cours"
                       Foreground="#E5E7EB"
                       FontSize="17"
                       FontWeight="SemiBold"/>

            <Grid Grid.Row="4">
                <ItemsControl x:Name="ActiveSessionsList"
                              ItemsSource="{Binding ActiveSessions}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveSessions}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="16"
                                    Background="#1D2024"
                                    BorderBrush="#30343A"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F2F4F7"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding StartedAtLabel}"
                                                   Foreground="#8F969F"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,0,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <controls:StatusBadge Text="EN COURS"
                                                              HorizontalAlignment="Right"/>

                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding DurationLabel}"
                                                   Foreground="#F2F4F7"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="ActiveSessionsEmptyState">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveSessions}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <controls:EmptyState Message="Aucune session active."/>
                </Border>
            </Grid>

            <TextBlock x:Name="RecentHistoryHeading"
                       Grid.Row="6"
                       Text="Historique récent"
                       Foreground="#E5E7EB"
                       FontSize="17"
                       FontWeight="SemiBold"/>

            <Border x:Name="RecentHistoryHost"
                    Grid.Row="8"
                    Padding="18"
                    Background="#181B1F"
                    BorderBrush="#2C3036"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ItemsControl ItemsSource="{Binding RecentSessions}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentSessions}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="#1D2024"
                                        BorderBrush="#30343A"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#F2F4F7"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding StartedAtLabel}"
                                                       Foreground="#8F969F"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="24,0,0,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DurationLabel}"
                                                       Foreground="#F2F4F7"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>

                                            <Button x:Name="RecentSessionDetailsButton"
                                                    Margin="0,8,0,0"
                                                    Content="Voir détails"
                                                    Click="RecentSessionDetailsButton_OnClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Aucune session récente."
                               Foreground="#A9AFB7"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentSessions}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ContentControl x:Name="SessionDetailHost"
                            Grid.Row="10"
                            Content="{Binding SelectedSessionDetail}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <sessions:SessionDetailView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </ScrollViewer>
</UserControl>
