<Window x:Class="PlayStead.UI.MainWindow"
        Icon="/PlayStead.UI;component/Assets/Branding/PlayStead.ico"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:library="clr-namespace:PlayStead.UI.Library"
        xmlns:notifications="clr-namespace:PlayStead.UI.Notifications"
        Title="PlayStead"
        Width="1643"
        Height="1106"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PlayStead.Brush.Background}"
        Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
        FontFamily="{DynamicResource PlayStead.Font.Sans}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PlayStead.Brush.Surface}"
                BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="PlaySteadWordmark"
                       Grid.Column="0"
                       Height="60"
                       Source="/PlayStead.UI;component/Assets/Branding/playstead-logo-horizontal.png"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />

                <StackPanel x:Name="PrimaryNavigation"
                            Grid.Column="1"
                            Margin="28,0,20,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="HomeNavButton"
                            Command="{Binding NavigateHomeCommand}"
                            Style="{DynamicResource PlayStead.Button.Navigation}"
                            Tag="{Binding IsHomeActive}"
                            AutomationProperties.Name="Accueil">
                        <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="{DynamicResource PlayStead.Icon.Home}" Style="{DynamicResource PlayStead.Icon.Navigation}" Stretch="Uniform"/><TextBlock Margin="8,0,0,0" Text="Accueil" Style="{DynamicResource PlayStead.Text.ButtonLabel}"/></StackPanel>
                    </Button>

                    <Button x:Name="LibraryNavButton"
                            Command="{Binding NavigateLibraryCommand}"
                            Style="{DynamicResource PlayStead.Button.Navigation}"
                            Tag="{Binding IsLibraryActive}"
                            AutomationProperties.Name="Bibliothèque">
                        <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="{DynamicResource PlayStead.Icon.Library}" Style="{DynamicResource PlayStead.Icon.Navigation}" Stretch="Uniform"/><TextBlock Margin="8,0,0,0" Text="Bibliothèque" Style="{DynamicResource PlayStead.Text.ButtonLabel}"/></StackPanel>
                    </Button>

                    <Button x:Name="AttentionNavButton"
                            Command="{Binding NavigateAttentionCommand}"
                            Style="{DynamicResource PlayStead.Button.Navigation}"
                            Tag="{Binding IsAttentionActive}"
                            AutomationProperties.Name="À signaler">
                        <StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="{DynamicResource PlayStead.Icon.Report}" Style="{DynamicResource PlayStead.Icon.Navigation}" Stretch="Uniform"/><TextBlock Margin="8,0,0,0" Text="À signaler" Style="{DynamicResource PlayStead.Text.ButtonLabel}"/></StackPanel>
                    </Button>

                </StackPanel>

                <Border Grid.Column="2" MinWidth="220" MaxWidth="520"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Margin="0,0,24,0" Padding="8,0"
                        Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource PlayStead.Radius.Small}">
                    <Grid>
                        <Path Width="18" Height="18" Margin="0,0,8,0" Panel.ZIndex="2" HorizontalAlignment="Left"
                              Data="{DynamicResource PlayStead.Icon.Search}"
                              Stroke="{DynamicResource PlayStead.Brush.TextSecondary}" StrokeThickness="1.5" Stretch="Uniform"/>
                        <TextBox x:Name="ShellSearchBox" DataContext="{Binding ElementName=PrimaryNavigation, Path=DataContext}"
                                 Margin="24,0,0,0" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Panel.ZIndex="1" KeyDown="ShellSearchBox_OnKeyDown" TextChanged="ShellSearchBox_OnTextChanged"
                                 GotKeyboardFocus="ShellSearchBox_OnKeyboardFocusChanged" LostKeyboardFocus="ShellSearchBox_OnKeyboardFocusChanged"
                                 ToolTip="Rechercher un jeu..." AutomationProperties.Name="Rechercher un jeu..." />
                        <TextBlock x:Name="ShellSearchPlaceholder" Margin="24,0,0,0" Panel.ZIndex="2"
                                   Text="Rechercher un jeu..." IsHitTestVisible="False"
                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="UtilityNavigation"
                            Grid.Column="3"
                            DataContext="{Binding ElementName=PrimaryNavigation, Path=DataContext}"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SettingsNavButton"
                            Command="{Binding NavigateSettingsCommand}"
                            Style="{DynamicResource PlayStead.Button.Icon}"
                            ToolTip="Paramètres"
                            AutomationProperties.Name="Paramètres">
                        <Path Width="16" Height="16" Data="{DynamicResource PlayStead.Icon.Settings}" Stroke="{DynamicResource PlayStead.Brush.IconPrimary}" StrokeThickness="1.5" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="AboutNavButton"
                            Command="{Binding NavigateAboutCommand}"
                            Style="{DynamicResource PlayStead.Button.Icon}"
                            ToolTip="À propos"
                            AutomationProperties.Name="À propos">
                        <Path Width="16" Height="16" Data="{DynamicResource PlayStead.Icon.Info}" Stroke="{DynamicResource PlayStead.Brush.IconPrimary}" StrokeThickness="1.5" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="NotificationBellButton"
                            Command="{Binding TogglePanelCommand}"
                            Style="{DynamicResource PlayStead.Button.Icon}"
                            ToolTip="Notifications"
                            AutomationProperties.Name="Notifications">
                        <Grid>
                            <Path Width="16" Height="16" Data="{DynamicResource PlayStead.Icon.Bell}" Stroke="{DynamicResource PlayStead.Brush.IconPrimary}" StrokeThickness="1.5" Stretch="Uniform"/>
                            <TextBlock x:Name="NotificationBadge"
                                       Text="{Binding ActiveCount}"
                                       Visibility="{Binding IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="6,0,0,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="GlobalSearchPopup"
               PlacementTarget="{Binding ElementName=ShellSearchBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding Search.IsOpen, Mode=OneWay}"
               Closed="GlobalSearchPopup_OnClosed"
               DataContext="{Binding ElementName=PrimaryNavigation, Path=DataContext}">
            <Border x:Name="GlobalSearchView"
                    Width="360"
                    MaxHeight="420"
                    Padding="{DynamicResource PlayStead.Spacing.1}"
                    Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Small}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Search.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="{DynamicResource PlayStead.Spacing.1}"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.Search.SelectResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="40"
                                               Height="40"
                                               Source="{Binding CoverPath}"
                                               Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="{DynamicResource PlayStead.Gap.Inline.ButtonIcon}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                       Text="{Binding ProviderLabel}"
                                                       Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                                       Style="{DynamicResource PlayStead.Text.Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun jeu trouvé"
                               Padding="{DynamicResource PlayStead.Spacing.1}"
                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search.Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>

        <ContentControl x:Name="MainContent"
                        Grid.Row="1">
            <library:LibraryView
                RescanRequested="LibraryView_OnRescanRequested" />
        </ContentControl>

        <Border x:Name="NotificationPanelHost"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Width="360"
                Visibility="{Binding IsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <notifications:NotificationPanel />
        </Border>

        <Border x:Name="AppUpdateNotificationHost"
                Grid.Row="1"
                Panel.ZIndex="40"
                Width="340"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,24,0"
                Padding="16"
                Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="Notification de mise à jour PlayStead">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Width="18"
                          Height="18"
                          VerticalAlignment="Center"
                          Data="{DynamicResource PlayStead.Icon.Verify}"
                          Stroke="{DynamicResource PlayStead.Brush.Copper}"
                          StrokeThickness="1.5"
                          Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"
                               Style="{DynamicResource PlayStead.Text.Body}"
                               Foreground="{DynamicResource PlayStead.Brush.Copper}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Margin="0,6,0,12"
                           Text="{Binding Detail}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PlayStead.Brush.TextSecondary}" />
                <Button Content="{Binding ActionLabel}"
                        Command="{Binding ActionCommand}"
                        AutomationProperties.Name="{Binding ActionLabel}"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource PlayStead.Button.Primary}" />
            </StackPanel>
        </Border>

        <Border x:Name="StartupOverlay" Grid.RowSpan="2" Panel.ZIndex="100"
                IsHitTestVisible="{Binding StartupProgress.IsBusy, ElementName=RootWindow}"
                Background="{DynamicResource PlayStead.Brush.Background}"
                Opacity="0.97"
                Visibility="{Binding StartupProgress.IsBusy, ElementName=RootWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Préparation de PlayStead" Style="{DynamicResource PlayStead.Text.Heading}" />
                <TextBlock Margin="0,12,0,16" Text="{Binding StartupProgress.Message, ElementName=RootWindow}" Style="{DynamicResource PlayStead.Text.Body}" />
                <ProgressBar x:Name="StartupProgressBar" Height="6" Style="{DynamicResource PlayStead.ProgressBar.Startup}" Maximum="{Binding StartupProgress.Total, ElementName=RootWindow}" Value="{Binding StartupProgress.Current, ElementName=RootWindow, Mode=OneWay}" IsIndeterminate="{Binding StartupProgress.IsProgressIndeterminate, ElementName=RootWindow}" />
                <TextBlock x:Name="StartupProgressCountLabel" Margin="0,10,0,0" Text="{Binding StartupProgress.CountLabel, ElementName=RootWindow}" Visibility="{Binding StartupProgress.HasCount, ElementName=RootWindow, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
