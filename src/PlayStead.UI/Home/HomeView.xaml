<UserControl x:Class="PlayStead.UI.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Background="{DynamicResource PlayStead.Brush.Background}"
             Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
             FontFamily="{DynamicResource PlayStead.Font.Body}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}">
            <Border x:Name="HomeHero"
                    Background="{DynamicResource PlayStead.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    Padding="{DynamicResource PlayStead.Spacing.4}">
                <StackPanel>
                    <TextBlock Text="PlayStead" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PlayStead.Brush.Copper}"/>
                    <TextBlock Text="Accueil" FontSize="26" FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <controls:KpiCard Label="Jeux dans la bibliothèque"
                              Value="{Binding LibraryGameCount}"
                              HorizontalAlignment="Left" MinWidth="240"
                              Margin="0,24,0,0"/>

            <TextBlock Text="Sessions en cours" FontSize="17" FontWeight="SemiBold"
                       Margin="0,24,0,8"/>
            <ItemsControl x:Name="ActiveSessionsList" ItemsSource="{Binding ActiveSessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayStead.Brush.Surface}"
                                CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                Padding="{DynamicResource PlayStead.Spacing.3}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StartedAtLabel}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DurationLabel}"
                                           Margin="24,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Activité récente" FontSize="17" FontWeight="SemiBold"
                       Margin="0,24,0,8"/>
            <ItemsControl x:Name="RecentActivityList" ItemsSource="{Binding RecentSessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayStead.Brush.Surface}"
                                CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                Padding="{DynamicResource PlayStead.Spacing.3}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StartedAtLabel}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DurationLabel}"
                                           Margin="24,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,24,0,0">
                <Button x:Name="OpenLibraryButton" Content="Bibliothèque"
                        Command="{Binding NavigateLibraryCommand}" Margin="0,0,8,8"/>
                <Button x:Name="OpenSessionsButton" Content="Sessions"
                        Command="{Binding NavigateSessionsCommand}" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
