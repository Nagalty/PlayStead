<UserControl x:Class="PlayStead.UI.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PlayStead.UI.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             SizeChanged="HomeView_OnSizeChanged"
             Background="{DynamicResource PlayStead.Brush.Background}"
             Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
             FontFamily="{DynamicResource PlayStead.Font.Body}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <sys:Double x:Key="HomeHeroHeight">140</sys:Double>
        <sys:Double x:Key="HomeEditorialHeight">320</sys:Double>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}">
            <WrapPanel x:Name="HomeKpiRow">
                <Border x:Name="InstalledGamesKpi"
                        Width="250"
                        Margin="{DynamicResource PlayStead.Spacing.1}"
                        Padding="{DynamicResource PlayStead.Spacing.2}"
                        Style="{DynamicResource PlayStead.Surface.Metric}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="42">
                            <Path Data="{StaticResource PlayStead.Icon.Gamepad}"
                                  Width="34"
                                  Height="30"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource PlayStead.Brush.Accent}"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LibraryGameCount}"
                                       Style="{DynamicResource PlayStead.Text.Display}" />
                            <TextBlock Text="Jeux installés"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="WeeklyPlaytimeKpi"
                        Width="250"
                        Margin="{DynamicResource PlayStead.Spacing.1}"
                        Padding="{DynamicResource PlayStead.Spacing.2}"
                        Style="{DynamicResource PlayStead.Surface.Metric}">
                    <StackPanel>
                        <TextBlock Text="{Binding WeeklyPlayTimeLabel}"
                                   Style="{DynamicResource PlayStead.Text.Display}" />
                        <TextBlock Text="{Binding WeeklyPlayTimeTitle}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                </Border>
                <Border x:Name="WeeklySessionsKpi"
                        Width="250"
                        Margin="{DynamicResource PlayStead.Spacing.1}"
                        Padding="{DynamicResource PlayStead.Spacing.2}"
                        Style="{DynamicResource PlayStead.Surface.Metric}">
                    <StackPanel>
                        <TextBlock Text="{Binding WeeklySummary.SessionCount}"
                                   Style="{DynamicResource PlayStead.Text.Display}" />
                        <TextBlock Text="{Binding WeeklySessionsTitle}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                </Border>
                <Border x:Name="WeeklyGamesKpi"
                        Width="250"
                        Margin="{DynamicResource PlayStead.Spacing.1}"
                        Padding="{DynamicResource PlayStead.Spacing.2}"
                        Style="{DynamicResource PlayStead.Surface.Metric}">
                    <StackPanel>
                        <TextBlock Text="{Binding GamesChangedSinceLastPlayCount}"
                                   Style="{DynamicResource PlayStead.Text.Display}" />
                        <TextBlock Text="{Binding GamesChangedSinceLastPlayLabel}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                        <TextBlock Text="{Binding GamesChangedSinceLastPlaySubtitle}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border x:Name="HomeMetadataProgressStrip"
                    Margin="0,8,0,0"
                    Padding="12,8"
                    Background="{DynamicResource PlayStead.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                    Visibility="{Binding IsMetadataProgressVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mise à jour des informations de jeu…"
                               Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MetadataProgressLabel, Mode=OneWay}"
                               Style="{DynamicResource PlayStead.Text.BodySecondary}"
                               Margin="12,0,0,0" />
                    <ProgressBar Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,7,0,0"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="{Binding MetadataProgressTotal, Mode=OneWay}"
                                 Value="{Binding MetadataProgressCompleted, Mode=OneWay}"
                                 Foreground="{DynamicResource PlayStead.Brush.Accent}"
                                 Background="{DynamicResource PlayStead.Brush.SurfaceElevated}" />
                </Grid>
            </Border>

            <Border x:Name="ActiveSessionHero"
                    Height="{DynamicResource HomeHeroHeight}"
                    Margin="{DynamicResource PlayStead.Gap.Block.Medium}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    ClipToBounds="True"
                    Visibility="{Binding HasActiveSessionHero, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveSessionHeroMedia}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding ActiveSessionHeroPath}"
                                                    Stretch="UniformToFill" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border Background="{DynamicResource PlayStead.Brush.Background}"
                            CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                            Opacity="0.9"
                            IsHitTestVisible="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.2" />
                                <GradientStop Color="#E6FFFFFF" Offset="0.32" />
                                <GradientStop Color="#B3FFFFFF" Offset="0.42" />
                                <GradientStop Color="#66FFFFFF" Offset="0.52" />
                                <GradientStop Color="#00FFFFFF" Offset="0.62" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}"
                                MaxWidth="520"
                                HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ActiveSessionEyebrow}"
                                   Style="{DynamicResource PlayStead.Text.Caption}"
                                   Foreground="{DynamicResource PlayStead.Brush.Accent}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveSessionTitle}"
                                   Style="{DynamicResource PlayStead.Text.PageTitle}"
                                   Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveSessionSupportingText}"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                        <Button Content="Voir le jeu"
                                Margin="{DynamicResource PlayStead.Gap.Block.Medium}"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenActiveSessionDetailsCommand}"
                                Style="{DynamicResource PlayStead.Button.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="IdleHeroPlaceholder"
                    Height="{DynamicResource HomeHeroHeight}"
                    Margin="{DynamicResource PlayStead.Gap.Block.Medium}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveSessionHero}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasEditorialPlaceholderImage}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding EditorialPlaceholderImageSource}"
                                                    Stretch="UniformToFill" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border Background="{DynamicResource PlayStead.Brush.Background}"
                            CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                            Opacity="0.56"
                            IsHitTestVisible="False" />
                    <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}"
                                MaxWidth="520"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Rien en cours pour l’instant."
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlayStead.Text.Caption}">
                                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Prêt à replonger ?"
                                   Style="{DynamicResource PlayStead.Text.PageTitle}"
                                   Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Lance un jeu, PlayStead s’occupe du reste."
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="HomeEditorialRegion"
                  Height="{DynamicResource HomeEditorialHeight}"
                  Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13*" />
                    <ColumnDefinition x:Name="HomeEditorialGapColumn" Width="16" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Border x:Name="EditorialPlaceholder"
                        Grid.Column="0"
                        Grid.Row="0"
                        VerticalAlignment="Stretch"
                        Margin="0"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                        Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSuggestion}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasEditorialPlaceholderImage}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{Binding EditorialPlaceholderImageSource}"
                                                Stretch="UniformToFill" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="EditorialPlaceholderContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="EditorialPlaceholderReadabilityLayer"
                            Grid.ColumnSpan="2"
                            Background="{DynamicResource PlayStead.Brush.Background}"
                            CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                            Opacity="0.56"
                            IsHitTestVisible="False">
                    </Border>
                    <StackPanel x:Name="EditorialPlaceholderText"
                                Grid.Column="0"
                                Margin="{DynamicResource PlayStead.Spacing.4}"
                                MaxWidth="520">
                        <TextBlock Text="SUGGESTION DU MOMENT"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlayStead.Text.Caption}">
                                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Une place pour ta prochaine aventure"
                                   Style="{DynamicResource PlayStead.Text.PageTitle}"
                                   Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Je prépare encore une idée pour ta prochaine partie."
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="SuggestionGameCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="{DynamicResource HomeEditorialHeight}"
                        VerticalAlignment="Stretch"
                        Margin="0"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuggestion}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSuggestionMedia}" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="{Binding SuggestionMediaPath}" Stretch="UniformToFill" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Border x:Name="SuggestionReadabilityOverlay"
                                CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#F20B1117" Offset="0" />
                                    <GradientStop Color="#F20B1117" Offset="0.4" />
                                    <GradientStop Color="#D90B1117" Offset="0.48" />
                                    <GradientStop Color="#800B1117" Offset="0.58" />
                                    <GradientStop Color="#260B1117" Offset="0.68" />
                                    <GradientStop Color="#000B1117" Offset="0.78" />
                                    <GradientStop Color="#000B1117" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="{DynamicResource PlayStead.Spacing.4}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Left"
                              MaxWidth="480">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                            <TextBlock Text="SUGGESTION DU MOMENT"
                                       Style="{DynamicResource PlayStead.Text.Caption}"
                                       FontSize="14"
                                       Foreground="{DynamicResource PlayStead.Brush.Accent}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SuggestionEditorialLine}"
                                       Style="{DynamicResource PlayStead.Text.PageTitle}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SuggestionSupportingText}"
                                       Visibility="{Binding HasSuggestionWeekdayContext, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SuggestionGameIdentity}"
                                       Visibility="{Binding HasSuggestionWeekendIdentity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{DynamicResource PlayStead.Text.CardTitle}"
                                       Margin="0,0,0,8"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SuggestionDescription}"
                                       Visibility="{Binding HasSuggestionDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                       Margin="0,0,0,8"
                                       MaxHeight="40"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,10">
                                <Path Width="24"
                                      Height="18"
                                      Data="{DynamicResource PlayStead.Icon.People}"
                                      Fill="{DynamicResource PlayStead.Brush.TextSecondary}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SuggestionCapabilityText}"
                                           Margin="8,0,0,0"
                                           Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasSuggestionUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,10">
                                <Path Width="14"
                                      Height="14"
                                      Data="{DynamicResource PlayStead.Icon.Attention}"
                                      Fill="{DynamicResource PlayStead.Brush.Accent}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SuggestionUpdateStatusText}"
                                           Margin="6,0,0,0"
                                           Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                           Foreground="{DynamicResource PlayStead.Brush.Accent}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasSuggestionBuildChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,10">
                                <Path Width="14"
                                      Height="14"
                                      Data="{DynamicResource PlayStead.Icon.History}"
                                      Stroke="{DynamicResource PlayStead.Brush.IconMuted}"
                                      StrokeThickness="1.4"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SuggestionBuildChangeText}"
                                           Margin="6,0,0,0"
                                           Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                                <Button Content="Voir les changements"
                                        Margin="12,0,0,0"
                                        Command="{Binding OpenSuggestionChangesCommand}"
                                        Style="{DynamicResource PlayStead.Button.Secondary}" />
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="1"
                                        VerticalAlignment="Bottom"
                                        Margin="0,16,0,0">
                                <Button Content="Jouer"
                                        Visibility="{Binding CanLaunchSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding PlaySuggestionCommand}"
                                        Style="{DynamicResource PlayStead.Button.Primary}" />
                                <Button Content="Détails"
                                        Margin="8,0,0,0"
                                        Command="{Binding OpenSuggestionDetailsCommand}"
                                        Style="{DynamicResource PlayStead.Button.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="DormantGameCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Stretch"
                        Margin="0"
                        Padding="0"
                        Style="{DynamicResource PlayStead.Surface.Card}"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                        ClipToBounds="True"
                        Visibility="{Binding HasDormantGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Border x:Name="DormantGameMedia"
                                CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding DormantGameMediaPath}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="DormantGameReadabilityOverlay"
                                CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#F20B1117" Offset="0" />
                                    <GradientStop Color="#F20B1117" Offset="0.4" />
                                    <GradientStop Color="#D90B1117" Offset="0.48" />
                                    <GradientStop Color="#800B1117" Offset="0.58" />
                                    <GradientStop Color="#260B1117" Offset="0.68" />
                                    <GradientStop Color="#000B1117" Offset="0.78" />
                                    <GradientStop Color="#000B1117" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    MaxWidth="520">
                            <TextBlock Text="ÇA FAIT UN BAIL…"
                                       Style="{DynamicResource PlayStead.Text.Caption}"
                                       FontSize="14"
                                       Foreground="{DynamicResource PlayStead.Brush.Accent}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DormantGameTitle}"
                                       Margin="0,6,0,0"
                                       Style="{DynamicResource PlayStead.Text.SectionTitle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Path Width="18"
                                      Height="18"
                                      Data="{DynamicResource PlayStead.Icon.History}"
                                      Stroke="{DynamicResource PlayStead.Brush.TextSecondary}"
                                      StrokeThickness="1.4"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DormantGameContext}"
                                           Margin="8,0,0,0"
                                           Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding DormantGameDescription}"
                                       Visibility="{Binding HasDormantGameDescription, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="0,16,0,0"
                                       MaxWidth="320"
                                       MaxHeight="40"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasDormantBuildChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,8,0,0">
                                <Path Width="14"
                                      Height="14"
                                      Data="{DynamicResource PlayStead.Icon.History}"
                                      Stroke="{DynamicResource PlayStead.Brush.IconMuted}"
                                      StrokeThickness="1.4"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DormantBuildChangeText}"
                                           Margin="6,0,0,0"
                                           Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                                <Button Content="Voir les changements"
                                        Margin="12,0,0,0"
                                        Command="{Binding OpenDormantChangesCommand}"
                                        Style="{DynamicResource PlayStead.Button.Secondary}" />
                            </StackPanel>
                            <Button Content="Voir le jeu"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenDormantGameDetailsCommand}"
                                    Style="{DynamicResource PlayStead.Button.Secondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="DormantGamePlaceholder"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Stretch"
                        Margin="0"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.Surface}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDormantGame}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasDormantPlaceholderImage}" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="{Binding DormantPlaceholderImageSource}" Stretch="UniformToFill" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Border Background="{DynamicResource PlayStead.Brush.Background}" Opacity="0.7" />
                        <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    MaxWidth="520">
                            <TextBlock Text="ÇA FAIT UN BAIL…"
                                       Style="{DynamicResource PlayStead.Text.Caption}"
                                       FontSize="14"
                                       Foreground="{DynamicResource PlayStead.Brush.Accent}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Rien ne prend la poussière pour l’instant."
                                       Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                       Style="{DynamicResource PlayStead.Text.SectionTitle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Les jeux laissés de côté referont surface ici quand le moment sera venu."
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="GamesDuMomentSection"
                        Margin="{DynamicResource PlayStead.Gap.Block.Small}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource PlayStead.Icon.Star}"
                          Width="20"
                          Height="20"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Fill="{DynamicResource PlayStead.Brush.TextSecondary}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Les habitués"
                                   Style="{DynamicResource PlayStead.Text.SectionTitle}"
                                   Foreground="{DynamicResource PlayStead.Brush.Accent}" />
                        <TextBlock Text="On sait très bien que tu vas y retourner."
                                   Style="{DynamicResource PlayStead.Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="GamesDuMomentList"
                              ItemsSource="{Binding GamesDuMoment}"
                              Visibility="{Binding HasGamesDuMoment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="GamesDuMomentCard"
                                    Width="{Binding CardWidth}"
                                    Height="135"
                                    Margin="{DynamicResource PlayStead.Spacing.1}"
                                    Focusable="True"
                                    KeyboardNavigation.IsTabStop="True"
                                    CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                    ClipToBounds="True"
                                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}" />
                                        <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=GamesDuMomentCard}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=GamesDuMomentCard}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenGamesDuMomentDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding GameId}" />
                                    <KeyBinding Key="Enter"
                                                Command="{Binding DataContext.OpenGamesDuMomentDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GameId}" />
                                    <KeyBinding Key="Space"
                                                Command="{Binding DataContext.OpenGamesDuMomentDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GameId}" />
                                </Border.InputBindings>
                                <Grid behaviors:RoundedClipBehavior.IsEnabled="True"
                                      behaviors:RoundedClipBehavior.CornerRadius="{DynamicResource PlayStead.Radius.Small}">
                                    <Image Source="{Binding LandscapeMediaPath}" Stretch="UniformToFill" />
                                    <Border VerticalAlignment="Stretch">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#000B1117" Offset="0" />
                                                <GradientStop Color="#000B1117" Offset="0.55" />
                                                <GradientStop Color="#400B1117" Offset="0.7" />
                                                <GradientStop Color="#D90B1117" Offset="0.9" />
                                                <GradientStop Color="#F20B1117" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding GameTitle}"
                                               VerticalAlignment="Bottom"
                                               Margin="{DynamicResource PlayStead.Spacing.2}"
                                               Style="{DynamicResource PlayStead.Text.CardTitle}"
                                               TextTrimming="CharacterEllipsis" />
                                        <StackPanel x:Name="RemoveGamesDuMomentActions"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="{DynamicResource PlayStead.Spacing.2}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=GamesDuMomentCard}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=GamesDuMomentCard}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button x:Name="MoveGamesDuMomentLeftButton"
                                                Margin="0,0,4,0"
                                                ToolTip="Déplacer vers la gauche"
                                                AutomationProperties.Name="Déplacer vers la gauche"
                                                Visibility="{Binding CanMoveLeft, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{DynamicResource PlayStead.Button.MediaAction}"
                                                Command="{Binding DataContext.MoveGamesDuMomentLeftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GameId}">
                                            <Path Data="{StaticResource PlayStead.Icon.ChevronLeft}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{DynamicResource PlayStead.Brush.TextPrimary}" StrokeThickness="1.6" />
                                        </Button>
                                        <Button x:Name="MoveGamesDuMomentRightButton"
                                                Margin="0,0,4,0"
                                                ToolTip="Déplacer vers la droite"
                                                AutomationProperties.Name="Déplacer vers la droite"
                                                Visibility="{Binding CanMoveRight, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{DynamicResource PlayStead.Button.MediaAction}"
                                                Command="{Binding DataContext.MoveGamesDuMomentRightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GameId}">
                                            <Path Data="{StaticResource PlayStead.Icon.ChevronRight}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{DynamicResource PlayStead.Brush.TextPrimary}" StrokeThickness="1.6" />
                                        </Button>
                                        <Button x:Name="RemoveGamesDuMomentButton"
                                                ToolTip="Retirer des habitués"
                                                AutomationProperties.Name="Retirer des habitués"
                                                Style="{DynamicResource PlayStead.Button.MediaAction}"
                                                Command="{Binding DataContext.RemoveGamesDuMomentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding GameId}">
<Path Data="{StaticResource PlayStead.Icon.Close}"
      Width="9"
      Height="9"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Stretch="Uniform"
      Stroke="{DynamicResource PlayStead.Brush.TextPrimary}"
      StrokeThickness="1.4" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="GamesDuMomentOnboarding"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource PlayStead.Surface.CardNested}"
                        Visibility="{Binding HasNoGamesDuMoment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Tes habitués n’attendent que toi."
                                   Style="{DynamicResource PlayStead.Text.CardTitle}" />
                        <TextBlock Text="Ajoute ceux que tu veux garder sous la main."
                                   Margin="0,4,0,0"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                        <Button Content="Parcourir la bibliothèque"
                                Margin="{DynamicResource PlayStead.Gap.Block.Small}"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateLibraryCommand}"
                                Style="{DynamicResource PlayStead.Button.Secondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="HomeAttentionSection"
                        Margin="{DynamicResource PlayStead.Gap.Block.Small}">
                <Border x:Name="HomeAttentionStripContainer"
                        Padding="{DynamicResource PlayStead.Spacing.2}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PlayStead.Surface.CardNested}">
                        </Style>
                    </Border.Style>
                <Grid x:Name="HomeAttentionStrip">
                    <Grid.Style>
                        <Style TargetType="Grid">
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Margin="{DynamicResource PlayStead.Spacing.1}"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="28" Height="20">
                                <Path Data="{StaticResource PlayStead.Icon.Attention}"
                                      x:Name="HomeAttentionSectionIcon"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"
                                      Fill="{x:Null}"
                                      Stroke="{DynamicResource PlayStead.Brush.Accent}"
                                      StrokeThickness="1.5" />
                            </Grid>
                            <TextBlock Text="À signaler"
                                       Style="{DynamicResource PlayStead.Text.SectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="Quelques éléments méritent ton attention."
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource PlayStead.Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1"
                                  x:Name="HomeAttentionItemsList"
                                  ItemsSource="{Binding HomeAttentionItems}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHomeAttention}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="260"
                                           Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border VerticalAlignment="Center"
                                        Focusable="True"
                                        KeyboardNavigation.IsTabStop="True"
                                        Padding="{DynamicResource PlayStead.Spacing.1}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenHomeAttentionItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.OpenHomeAttentionItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        <KeyBinding Key="Space"
                                                    Command="{Binding DataContext.OpenHomeAttentionItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="96"
                                                Height="96"
                                                Margin="0,0,8,0"
                                                Background="{x:Null}"
                                                BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                                BorderThickness="1"
                                                Opacity="0.72"
                                                CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                                            <Grid>
                                                <Image Source="{Binding MediaPath}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,96,96"
                                                                            RadiusX="8"
                                                                            RadiusY="8" />
                                                    </Image.Clip>
                                                </Image>
                                                <Path Data="{StaticResource PlayStead.Icon.Attention}"
                                                      x:Name="HomeAttentionItemFallbackIcon"
                                                      Width="16"
                                                      Height="16"
                                                      Stretch="Uniform"
                                                      Fill="{x:Null}"
                                                      Stroke="{DynamicResource PlayStead.Brush.Accent}"
                                                      StrokeThickness="1.25">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Style="{DynamicResource PlayStead.Text.CardTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayTitle}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Column="1"
                          x:Name="HomeAttentionEmptyState"
                          VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHomeAttention}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="Tout roule. Rien ne demande ton attention."
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                            <TextBlock Text="Les éléments importants apparaîtront ici."
                                       Margin="0,4,0,0"
                                       Style="{DynamicResource PlayStead.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="2"
                            Content="Tout voir"
                            Command="{Binding NavigateAttentionCommand}"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlayStead.Button.Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHomeAttention}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="RecentlyPlayedSection"
                        Margin="{DynamicResource PlayStead.Gap.Block.Small}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource PlayStead.Icon.History}"
                          Width="20"
                          Height="20"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Fill="{x:Null}"
                          Stroke="{DynamicResource PlayStead.Brush.TextSecondary}"
                          StrokeThickness="1.6" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Récemment joués"
                                   Style="{DynamicResource PlayStead.Text.SectionTitle}"
                                   Foreground="{DynamicResource PlayStead.Brush.Accent}" />
                        <TextBlock Text="Là où l’aventure continue."
                                   Style="{DynamicResource PlayStead.Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="RecentlyPlayedSeeAllButton"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding NavigateSessionsCommand}"
                            Visibility="{Binding HasRecentlyPlayedGames, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{DynamicResource PlayStead.Button.Ghost}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tout voir"
                                       Margin="{DynamicResource PlayStead.Gap.Inline.Small}"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                            <Path Data="{StaticResource PlayStead.Icon.ChevronRight}"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{x:Null}"
                                  Stroke="{DynamicResource PlayStead.Brush.TextSecondary}"
                                  StrokeThickness="1.6" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="RecentlyPlayedGamesList"
                              ItemsSource="{Binding RecentlyPlayedGames}"
                              Visibility="{Binding HasRecentlyPlayedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RecentlyPlayedCard"
                                    Width="275"
                                    Margin="{DynamicResource PlayStead.Spacing.1}"
                                    Focusable="True"
                                    KeyboardNavigation.IsTabStop="True">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenRecentlyPlayedDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding GameId}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <Border x:Name="RecentlyPlayedArtwork"
                                    Grid.ColumnSpan="2"
                                    Height="145"
                                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                                            CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                            ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}" />
                                                <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RecentlyPlayedCard}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RecentlyPlayedCard}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid behaviors:RoundedClipBehavior.IsEnabled="True"
                                              behaviors:RoundedClipBehavior.CornerRadius="{DynamicResource PlayStead.Radius.Small}">
                                            <Image Source="{Binding LandscapeMediaPath}"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLandscapeMedia}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <Grid x:Name="RecentlyPlayedInfoOverlay"
                                                  Height="72"
                                                  VerticalAlignment="Bottom">
                                                <Rectangle x:Name="RecentlyPlayedOverlayBackground">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#000B1117" Offset="0" />
                                                            <GradientStop Color="#400B1117" Offset="0.22" />
                                                            <GradientStop Color="#A60B1117" Offset="0.62" />
                                                            <GradientStop Color="#F20B1117" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <StackPanel Margin="{DynamicResource PlayStead.Spacing.1}"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding HasProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Style="{DynamicResource PlayStead.Status.Badge.Neutral}"
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding ProviderLabel}"
                                                                       Style="{DynamicResource PlayStead.Text.Caption}" />
                                                        </Border>
                                                        <Border Margin="{DynamicResource PlayStead.Gap.Inline.Small}"
                                                                Style="{DynamicResource PlayStead.Status.Badge.Warning}"
                                                                Padding="6,2"
                                                                Visibility="{Binding HasMeaningfulStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       Style="{DynamicResource PlayStead.Text.Caption}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GameTitle}"
                                                               Style="{DynamicResource PlayStead.Text.CardTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayStartedAtLabel}"
                                                                   Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text=" · "
                                                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                                                        <TextBlock Text="{Binding DisplayDurationLabel}"
                                                                   Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="RecentlyPlayedQuickActions"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="{DynamicResource PlayStead.Spacing.2}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RecentlyPlayedCard}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RecentlyPlayedCard}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button x:Name="RecentlyPlayedPlayButton"
                                                        Width="32"
                                                        Height="32"
                                                        MinHeight="0"
                                                        Margin="{DynamicResource PlayStead.Gap.Inline.Small}"
                                                        Padding="0"
                                                        ToolTip="Jouer"
                                                        AutomationProperties.Name="Jouer"
                                                        Style="{DynamicResource PlayStead.Button.MediaAction}"
                                                        Command="{Binding DataContext.PlayRecentlyPlayedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding GameId}">
                                                    <Path Data="{StaticResource PlayStead.Icon.Play}"
                                                          Width="16"
                                                          Height="16"
                                                          Stretch="Uniform"
                                                          Fill="{DynamicResource PlayStead.Brush.Accent}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="RecentlyPlayedEmptyState"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource PlayStead.Surface.CardNested}"
                        Visibility="{Binding HasNoRecentlyPlayedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="L’histoire commence à ta prochaine partie."
                                   Style="{DynamicResource PlayStead.Text.CardTitle}" />
                        <TextBlock Text="Tes dernières sessions apparaîtront ici."
                                   Margin="0,4,0,0"
                                   Style="{DynamicResource PlayStead.Text.BodySecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
