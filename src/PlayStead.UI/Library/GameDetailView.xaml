<UserControl x:Class="PlayStead.UI.Library.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Background="Transparent"
             FontFamily="{DynamicResource PlayStead.Font.Body}"
             SizeChanged="GameDetailView_OnSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource PlayStead.Spacing.4}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="{DynamicResource PlayStead.Spacing.4}"
                    Background="{DynamicResource PlayStead.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Large}">
                <Grid>
                    <controls:GameArtwork SourcePath="{Binding CoverPath}"
                                          HasArtwork="{Binding HasCover}"
                                          Title="{Binding Title}"
                                          ProviderLabel="{Binding ProviderLabel}"
                                          Height="240"/>

                    <Border Margin="12"
                            Padding="{DynamicResource PlayStead.Spacing.4}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            MinWidth="300"
                            Background="{DynamicResource PlayStead.Brush.Surface}"
                            BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <controls:StatusBadge Margin="0,8,0,0"
                                                  Text="{Binding ProviderLabel}"/>

                            <TextBlock Margin="0,18,0,0"
                                       Text="{Binding InstallPath}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                       FontSize="13"
                                       Visibility="{Binding HasInstallPath,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding InstalledSizeLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="13"
                                       Visibility="{Binding HasInstalledSize,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SteamStatusLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                       FontSize="13"
                                       Visibility="{Binding HasSteamStatus,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SessionStatusLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                       FontSize="13"
                                       Visibility="{Binding Game.IsSessionActive,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <controls:PlaySplitButton Margin="0,20,0,0"
                                                      DataContext="{Binding Launch}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="DetailColumns"
                  Grid.Row="1"
                  Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="InstallationInformation"
                            Grid.Column="1">
                <Border x:Name="InstallationPanel"
                        Margin="0,0,0,9"
                        Padding="{DynamicResource PlayStead.Spacing.3}"
                        Background="{DynamicResource PlayStead.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                    <StackPanel>
                        <controls:SectionHeader Title="Source / plateforme"/>

                        <controls:StatusBadge Margin="0,10,0,0"
                                              Text="{Binding ProviderLabel}"/>

                        <TextBlock x:Name="InstallationPathRow"
                                   Margin="0,10,0,0"
                                   Text="{Binding InstallPath}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="14"
                                   Visibility="{Binding HasInstallPath,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="InstalledSizeRow"
                                   Margin="0,8,0,0"
                                   Text="{Binding InstalledSizeLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                   FontSize="13"
                                   Visibility="{Binding HasInstalledSize,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LocalStatusPanel"
                        Grid.Row="1"
                        Margin="0,9,0,0"
                        Padding="{DynamicResource PlayStead.Spacing.3}"
                        Background="{DynamicResource PlayStead.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                    <StackPanel>
                        <controls:SectionHeader Title="État local"/>

                        <controls:StatusBadge x:Name="SteamStatusRow"
                                              Margin="0,10,0,0"
                                              Text="{Binding SteamStatusLabel}"
                                              Visibility="{Binding HasSteamStatus,
                                                           Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <controls:StatusBadge Margin="0,8,0,0"
                                   Text="{Binding SessionStatusLabel}"
                                   Visibility="{Binding Game.IsSessionActive,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                </StackPanel>

            <Border x:Name="GameActivity"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,9,0"
                    Padding="{DynamicResource PlayStead.Spacing.3}"
                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    Visibility="{Binding Activity.HasSessionHistory,
                                         Converter={StaticResource BooleanToVisibilityConverter},
                                         FallbackValue=Collapsed}">
                <StackPanel>
                    <controls:SectionHeader Title="Ton jeu / Activité"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dernière activité"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,12,0"
                                       Text="{Binding Activity.LastActivityLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Temps total"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,12,0"
                                       Text="{Binding Activity.TotalPlayTimeLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sessions"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Activity.SessionCountLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Activity.LastSessionDateLabel}"
                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                               FontSize="13"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Activity.LastSessionDurationLabel}"
                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            </Grid>

            <Border Grid.Row="3"
                    Margin="0,18,0,0"
                    Padding="{DynamicResource PlayStead.Spacing.3}"
                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                <StackPanel>
                    <controls:SectionHeader Title="Données disponibles"/>

                    <TextBlock Margin="0,10,0,0"
                               Text="Cette fiche affiche uniquement les métadonnées locales actuellement connues par PlayStead."
                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
