<UserControl x:Class="PlayStead.UI.Library.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24"
                    Background="{DynamicResource PlayStead.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding ProviderLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.Copper}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="24,0,0,0"
                            Padding="14,8"
                            VerticalAlignment="Top"
                            Background="{DynamicResource PlayStead.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource PlayStead.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="{Binding SessionStatusLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,9,0"
                        Padding="20"
                        Background="{DynamicResource PlayStead.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Installation"
                                   Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding InstallPath}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding InstalledSizeLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="9,0,0,0"
                        Padding="20"
                        Background="{DynamicResource PlayStead.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="État"
                                   Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding SteamStatusLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="20"
                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Données disponibles"
                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Margin="0,10,0,0"
                               Text="Cette fiche affiche uniquement les métadonnées locales actuellement connues par PlayStead."
                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <controls:PlaySplitButton Grid.Row="3" Margin="0,18,0,0"
                                      DataContext="{Binding Launch}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
