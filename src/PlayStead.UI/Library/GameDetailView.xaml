<UserControl x:Class="PlayStead.UI.Library.GameDetailView"
             x:Name="GameDetailRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Background="Transparent"
             FontFamily="{DynamicResource PlayStead.Font.Body}"
             SizeChanged="GameDetailView_OnSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    x:Name="GameDetailHero"
                    MinHeight="320"
                    Padding="0"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource PlayStead.Brush.Surface}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHero}"
                                         Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding HeroPath}"
                                                    Stretch="UniformToFill"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border x:Name="HeroContentRail"
                            HorizontalAlignment="Left"
                            Margin="0"
                            Width="520"
                            Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                            Opacity="0.86">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5"
                                                 EndPoint="1,0.5">
                                <GradientStop Offset="0"
                                              Color="#FF000000"/>
                                <GradientStop Offset="0.72"
                                              Color="#EE000000"/>
                                <GradientStop Offset="1"
                                              Color="#00000000"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <Border Width="176"
                            Height="264"
                            Margin="24,24,0,24"
                            CornerRadius="12"
                            ClipToBounds="True"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <controls:GameArtwork SourcePath="{Binding CoverPath}"
                                              HasArtwork="{Binding HasCover}"
                                              Title="{Binding Title}"
                                              ProviderLabel="{Binding ProviderLabel}"
                                              Width="176"
                                              Height="264"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                            <controls:GameArtwork.Clip>
                                <RectangleGeometry Rect="0,0,176,264"
                                                    RadiusX="12"
                                                    RadiusY="12"/>
                            </controls:GameArtwork.Clip>
                        </controls:GameArtwork>
                    </Border>

                    <StackPanel x:Name="HeroContent"
                                Margin="214,44,20,44"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel x:Name="HeroPlatformRow"
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <controls:StatusBadge Text="{Binding ProviderLabel}"/>
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,0"
                                   Orientation="Horizontal"
                                   Visibility="{Binding Activity.HasSessionHistory,
                                                Converter={StaticResource BooleanToVisibilityConverter},
                                                FallbackValue=Collapsed}">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Temps joué"
                                           Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Activity.TotalPlayTimeLabel}"
                                               Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Dernière partie"
                                           Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Activity.LastActivityLabel}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SessionStatusLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding Game.IsSessionActive,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <WrapPanel x:Name="GameDetailCtaRow"
                                   Margin="0,22,0,0"
                                   Orientation="Horizontal">
                            <controls:PlaySplitButton PrimaryButtonMinWidth="150"
                                                      PrimaryButtonPadding="20,14"
                                                      IsSessionActive="{Binding DataContext.Game.IsSessionActive, ElementName=GameDetailRoot}"
                                                      PlayLabel="{Binding DataContext.SessionStatusLabel,
                                                                  ElementName=GameDetailRoot,
                                                                  TargetNullValue=Jouer,
                                                                  FallbackValue=Jouer}"
                                                      DataContext="{Binding Launch}"/>
                            <Button Style="{DynamicResource PlayStead.Button.Secondary}"
                                    Command="{Binding DataContext.Launch.OpenProviderCommand, ElementName=GameDetailRoot}"
                                    Visibility="{Binding DataContext.Launch.CanOpenProvider, ElementName=GameDetailRoot, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                    AutomationProperties.Name="{Binding DataContext.Launch.ProviderDisplayName, ElementName=GameDetailRoot}"
                                    Margin="{DynamicResource PlayStead.Gap.Inline.Cta}"
                                    Padding="20,14">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="18" Height="18"
                                          Margin="{DynamicResource PlayStead.Gap.Inline.ButtonIcon}"
                                          Data="{DynamicResource PlayStead.Icon.External}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Opacity="0.82"/>
                                    <TextBlock Text="{Binding DataContext.Launch.ProviderDisplayName, ElementName=GameDetailRoot, StringFormat=Ouvrir {0}}"
                                               Style="{DynamicResource PlayStead.Text.PrimaryButtonLabel}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="{DynamicResource PlayStead.Spacing.4}">
            <Grid x:Name="DetailColumns"
                  Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="InstallationInformation"
                            Grid.Column="1">
                <Border x:Name="InstallationPanel"
                        Margin="0,0,0,9"
                        Style="{DynamicResource PlayStead.Surface.Card}">
                    <StackPanel>
                        <controls:SectionHeader Title="Source / plateforme"/>

                        <controls:StatusBadge Margin="0,10,0,0"
                                              Text="{Binding ProviderLabel}"/>

                        <TextBlock x:Name="InstallationPathRow"
                                   Margin="0,10,0,0"
                                   Text="{Binding InstallPath}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                   FontSize="14"
                                   Visibility="{Binding HasInstallPath,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="InstalledSizeRow"
                                   Margin="0,8,0,0"
                                   Text="{Binding InstalledSizeLabel}"
                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                   FontSize="13"
                                   Visibility="{Binding HasInstalledSize,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LocalStatusPanel"
                        Grid.Row="1"
                        Margin="0,9,0,0"
                        Padding="{DynamicResource PlayStead.Spacing.3}"
                        Background="{DynamicResource PlayStead.Brush.Surface}"
                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                    <StackPanel>
                        <controls:SectionHeader Title="État local"/>

                        <controls:StatusBadge x:Name="SteamStatusRow"
                                              Margin="0,10,0,0"
                                              Text="{Binding SteamStatusLabel}"
                                              Visibility="{Binding HasSteamStatus,
                                                           Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <controls:StatusBadge Margin="0,8,0,0"
                                   Text="{Binding SessionStatusLabel}"
                                   Visibility="{Binding Game.IsSessionActive,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                </StackPanel>

            <Border x:Name="GameActivity"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,9,0"
                    Padding="{DynamicResource PlayStead.Spacing.3}"
                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    Visibility="{Binding Activity.HasSessionHistory,
                                         Converter={StaticResource BooleanToVisibilityConverter},
                                         FallbackValue=Collapsed}">
                <StackPanel>
                    <controls:SectionHeader Title="Ton jeu / Activité"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dernière activité"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,12,0"
                                       Text="{Binding Activity.LastActivityLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Temps total"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,12,0"
                                       Text="{Binding Activity.TotalPlayTimeLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sessions"
                                       Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                       FontSize="12"/>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Activity.SessionCountLabel}"
                                       Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                       FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Activity.LastSessionDateLabel}"
                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                               FontSize="13"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Activity.LastSessionDurationLabel}"
                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            </Grid>

            <Border Margin="0,18,0,0"
                    Padding="{DynamicResource PlayStead.Spacing.3}"
                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}">
                <StackPanel>
                    <controls:SectionHeader Title="Données disponibles"/>

                    <TextBlock Margin="0,10,0,0"
                               Text="Cette fiche affiche uniquement les métadonnées locales actuellement connues par PlayStead."
                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
