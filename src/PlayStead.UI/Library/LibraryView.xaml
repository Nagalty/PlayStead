<UserControl x:Class="PlayStead.UI.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             Background="Transparent"
             SizeChanged="LibraryView_OnSizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LibraryHeading"
                       Grid.Column="0"
                       Text="Bibliothèque"
                       Foreground="#F2F4F7"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Grid Grid.Column="1"
                  Margin="24,0,24,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="LibrarySearchBox"
                         Grid.Column="0"
                         Height="36"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         Background="#202429"
                         Foreground="#F2F4F7"
                         BorderBrush="#3A3F46"
                         BorderThickness="1"
                         TextChanged="LibrarySearchBox_OnTextChanged"
                         ToolTip="Rechercher dans la bibliothèque (Ctrl+K)"/>

                <Button x:Name="ClearSearchButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Content="Effacer"
                        Click="ClearSearchButton_OnClick"
                        Visibility="{Binding IsSearchActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#262A2F"
                        Foreground="#E9EAEC"
                        BorderBrush="#555B63"
                        BorderThickness="1"/>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="GridModeButton"
                        Tag="Grid"
                        Content="Grille"
                        Click="GridModeButton_OnClick"
                        Padding="12,8"
                        Background="#262A2F"
                        Foreground="#E9EAEC"
                        BorderBrush="#555B63"
                        BorderThickness="1"/>

                <Button x:Name="ListModeButton"
                        Tag="List"
                        Content="Liste"
                        Click="ListModeButton_OnClick"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Background="#262A2F"
                        Foreground="#E9EAEC"
                        BorderBrush="#555B63"
                        BorderThickness="1"/>

                <Button x:Name="VerifySteamButton"
                        Content="Vérifier Steam"
                        IsEnabled="{Binding CanVerifySteam}"
                        Click="VerifySteamButton_OnClick"
                        Padding="14,8"
                        Margin="16,0,0,0"
                        Background="#262A2F"
                        Foreground="#E9EAEC"
                        BorderBrush="#8D623E"
                        BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="GameGridRows"
                      Grid.Row="2"
                      ItemsSource="{Binding GridRows}"
                      Visibility="{Binding IsGridMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="GridScrollViewer"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:GameCard SelectionRequested="GameCard_OnSelectionRequested"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="GameList"
                      Grid.Row="2"
                      ItemsSource="{Binding VisibleItems}"
                      Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="ListScrollViewer"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            Background="#1D2024"
                            BorderBrush="#30343A"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           Foreground="#F2F4F7"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Orientation="Horizontal">
                                    <controls:StatusBadge Text="{Binding SessionStatusLabel}"
                                                          Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Border Margin="8,0,0,0"
                                            Padding="8,3"
                                            Background="#25292E"
                                            BorderBrush="#3A3F46"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Visibility="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SteamStatusLabel}"
                                                   Foreground="#D7B08C"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       Foreground="#A9AFB7"
                                       FontSize="13">
                                <Run Text="{Binding ProviderLabel}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding InstalledSizeLabel, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="2"
                                       Margin="0,6,0,0"
                                       Text="{Binding InstallPath}"
                                       Foreground="#7F8791"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <ContentControl x:Name="GameQuickPanel"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="340"
                        Margin="20,0,0,0"
                        Panel.ZIndex="10"
                        Content="{Binding SelectedItem}"
                        Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border Padding="20"
                            Background="#202429"
                            BorderBrush="#3A3F46"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           Foreground="#F2F4F7"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button x:Name="CloseQuickPanelButton"
                                        Grid.Column="1"
                                        Content="✕"
                                        Click="CloseQuickPanelButton_OnClick"
                                        Margin="12,0,0,0"
                                        Padding="8,4"
                                        Background="Transparent"
                                        Foreground="#A9AFB7"
                                        BorderBrush="#3A3F46"
                                        BorderThickness="1"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Margin="0,14,0,0"
                                       Foreground="#A9AFB7"
                                       FontSize="13">
                                <Run Text="{Binding ProviderLabel}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding InstalledSizeLabel, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="2"
                                       Margin="0,10,0,0"
                                       Text="{Binding InstallPath}"
                                       Foreground="#7F8791"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <StackPanel Grid.Row="3"
                                        Margin="0,16,0,0"
                                        Orientation="Horizontal">
                                <controls:StatusBadge Text="{Binding SessionStatusLabel}"
                                                      Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Border Margin="8,0,0,0"
                                        Padding="8,3"
                                        Background="#25292E"
                                        BorderBrush="#3A3F46"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SteamStatusLabel}"
                                               Foreground="#D7B08C"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="OpenGameDetailButton"
                                    Grid.Row="4"
                                    Content="Voir la fiche"
                                    Click="OpenGameDetailButton_OnClick"
                                    Margin="0,20,0,0"
                                    Padding="14,10"
                                    HorizontalAlignment="Stretch"
                                    Background="#8D623E"
                                    Foreground="#F7F7F8"
                                    BorderThickness="0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock x:Name="EmptyStateText"
                       Text="Aucun jeu local détecté."
                       Foreground="#A9AFB7"
                       FontSize="15"
                       HorizontalAlignment="Center"/>

            <Button x:Name="RescanButton"
                    Content="Relancer l’analyse"
                    Click="RescanButton_OnClick"
                    Margin="0,14,0,0"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    Background="#262A2F"
                    Foreground="#E9EAEC"
                    BorderBrush="#555B63"
                    BorderThickness="1"/>
        </StackPanel>
    </Grid>
</UserControl>
