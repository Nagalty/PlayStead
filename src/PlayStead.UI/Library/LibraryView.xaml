<UserControl x:Class="PlayStead.UI.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayStead.UI.Controls"
             xmlns:library="clr-namespace:PlayStead.UI.Library"
             xmlns:steam="clr-namespace:PlayStead.Core.Steam;assembly=PlayStead.Core"
             Background="Transparent"
             SizeChanged="LibraryView_OnSizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <ControlTemplate x:Key="Library.SortComboToggleTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
        </ControlTemplate>

        <Style x:Key="Library.FilterCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource PlayStead.Font.Body}" />
            <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.14}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{DynamicResource PlayStead.Spacing.2}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{DynamicResource PlayStead.Brush.SurfaceSubtle}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2,8 L 6,12 L 14,3"
                                      Stroke="{DynamicResource PlayStead.Brush.Copper}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Copper}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Library.FilterSectionTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PlayStead.Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style x:Key="Library.FilterResetButton"
               TargetType="Button"
               BasedOn="{StaticResource PlayStead.Button.Secondary}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="Library.ViewModeButton"
               TargetType="Button"
               BasedOn="{StaticResource PlayStead.Button.Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGridMode}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Grid" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsListMode}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="List" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsModdedQuickFilter}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Modded" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Library.QuickFilterButton"
               TargetType="Button"
               BasedOn="{StaticResource PlayStead.Button.Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInstalledQuickFilter}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Installed" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAttentionQuickFilter}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Attention" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                    <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Library.VerifySteamButton"
               TargetType="Button"
               BasedOn="{StaticResource PlayStead.Button.Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource PlayStead.FontSize.13}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="Library.ListSteamStatusBadge"
               TargetType="Border"
               BasedOn="{StaticResource PlayStead.Status.Badge.Neutral}">
            <Setter Property="Visibility"
                    Value="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SteamState}"
                             Value="{x:Static steam:SteamUpdateState.Unknown}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Library.ListRow"
               TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceSubtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Library.SortComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
            <Setter Property="Padding" Value="{DynamicResource PlayStead.Control.Padding}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.AccentMuted}" />
                                <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Copper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Library.SortComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource PlayStead.ControlBase}">
            <Setter Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource PlayStead.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Border}" />
            <Setter Property="BorderThickness" Value="{DynamicResource PlayStead.Border.Thin}" />
            <Setter Property="Padding" Value="{DynamicResource PlayStead.Control.Padding}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Library.SortComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Template="{StaticResource Library.SortComboToggleTemplate}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center" />
                                    <Path Grid.Column="1"
                                          Margin="{DynamicResource PlayStead.Spacing.2}"
                                          Data="M 0,0 L 8,0 L 4,4 Z"
                                          Fill="{DynamicResource PlayStead.Brush.IconMuted}"
                                          Stretch="Uniform"
                                          Width="8"
                                          Height="5"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False"
                                   HorizontalOffset="0"
                                   VerticalOffset="2">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource PlayStead.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                        BorderThickness="{DynamicResource PlayStead.Border.Thin}"
                                        CornerRadius="{DynamicResource PlayStead.Radius.Small}">
                                    <ScrollViewer MaxHeight="320"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Background="{DynamicResource PlayStead.Brush.SurfaceRaised}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_ToggleButton" Property="Background" Value="{DynamicResource PlayStead.Brush.SurfaceHover}" />
                                <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.CopperHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{DynamicResource PlayStead.Brush.Copper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="{DynamicResource PlayStead.Inset.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LibraryHeading"
                       Grid.Column="0"
                       Text="Bibliothèque"
                       Style="{DynamicResource PlayStead.Text.PageTitle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="InstalledFilterButton"
                        Tag="Installed"
                        Content="Installés"
                        Click="InstalledFilterButton_OnClick"
                        Style="{DynamicResource Library.QuickFilterButton}"
                        ToolTip="Afficher les jeux installés" />
                <Button x:Name="AttentionFilterButton"
                        Tag="Attention"
                        Content="À signaler"
                        Click="AttentionFilterButton_OnClick"
                        Style="{DynamicResource Library.QuickFilterButton}"
                        ToolTip="Afficher les jeux avec une attention active" />
                <Button x:Name="ModdedFilterButton"
                        Tag="Modded"
                        Content="Moddés"
                        Click="ModdedFilterButton_OnClick"
                        Style="{DynamicResource Library.QuickFilterButton}"
                        ToolTip="Afficher les jeux avec une preuve de modding confirmée" />
                <Button x:Name="AdvancedFiltersButton"
                        Content="{Binding AdvancedFilterButtonLabel}"
                        Click="AdvancedFiltersButton_OnClick"
                        Style="{DynamicResource Library.QuickFilterButton}"
                        ToolTip="Filtrer la bibliothèque" />
                <TextBlock Text="Trier par :"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PlayStead.Brush.TextSecondary}" />
                <ComboBox x:Name="LibrarySortComboBox"
                          Width="150"
                          Style="{DynamicResource Library.SortComboBox}"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SortKey, Mode=OneWay}"
                          SelectionChanged="LibrarySortComboBox_OnSelectionChanged"
                          ToolTip="Trier la bibliothèque">
                    <ComboBoxItem Tag="Recent" Content="Récemment joué" />
                    <ComboBoxItem Tag="Playtime" Content="Temps de jeu" />
                    <ComboBoxItem Tag="Title" Content="Nom" />
                    <ComboBoxItem Tag="Size" Content="Taille" />
                </ComboBox>
                <Border Style="{DynamicResource PlayStead.Surface.CardNested}"
                        Padding="{DynamicResource PlayStead.Spacing.1}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="GridModeButton"
                                Tag="Grid"
                                Click="GridModeButton_OnClick"
                                Style="{DynamicResource Library.ViewModeButton}"
                                ToolTip="Afficher la bibliothèque en grille">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE8A9;"
                                           VerticalAlignment="Center"/>
                                <TextBlock Margin="8,0,0,0"
                                           Text="Grille"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ListModeButton"
                                Tag="List"
                                Click="ListModeButton_OnClick"
                                Style="{DynamicResource Library.ViewModeButton}"
                                ToolTip="Afficher la bibliothèque en liste">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE8FD;"
                                           VerticalAlignment="Center"/>
                                <TextBlock Margin="8,0,0,0"
                                           Text="Liste"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Button x:Name="VerifySteamButton"
                        IsEnabled="{Binding CanVerifySteam}"
                        Click="VerifySteamButton_OnClick"
                        Margin="{DynamicResource PlayStead.Gap.Inline.Cta}"
                        Style="{DynamicResource Library.VerifySteamButton}"
                        ToolTip="Vérifier les installations Steam">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource PlayStead.Brush.IconMuted}"
                                   Text="&#xE73E;"
                                   VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0"
                                   Text="Vérifier Steam"
                                   Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <Popup x:Name="AdvancedFiltersPopup"
               Grid.Row="0"
               PlacementTarget="{Binding ElementName=AdvancedFiltersButton}"
               Placement="Bottom"
               StaysOpen="False"
               Closed="AdvancedFiltersPopup_OnClosed"
               IsOpen="{Binding IsAdvancedFiltersOpen, Mode=OneWay}"
               AllowsTransparency="True">
            <Border MinWidth="260"
                    MaxHeight="620"
                    Padding="16"
                    Background="{DynamicResource PlayStead.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource PlayStead.Brush.AccentMuted}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Filtres" Style="{DynamicResource PlayStead.Text.SectionTitle}" />
                    <TextBlock Text="SOURCE" Style="{DynamicResource Library.FilterSectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ProviderFilterOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{DynamicResource Library.FilterCheckBox}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="DISQUE"
                               Style="{DynamicResource Library.FilterSectionTitle}"
                               Visibility="{Binding HasDriveFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DriveFilterOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{DynamicResource Library.FilterCheckBox}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="MODES DE JEU" Style="{DynamicResource Library.FilterSectionTitle}" />
                    <ItemsControl ItemsSource="{Binding CapabilityFilterOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{DynamicResource Library.FilterCheckBox}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="GENRES">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Library.FilterSectionTitle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GenreFilterOptions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding GenreFilterOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{DynamicResource Library.FilterCheckBox}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="COLLECTIONS" Style="{DynamicResource Library.FilterSectionTitle}" />
                    <ItemsControl ItemsSource="{Binding CollectionOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsFilterSelected, Mode=TwoWay}" Style="{DynamicResource Library.FilterCheckBox}" />
                                    <Button Grid.Column="1" Content="Renommer" Tag="{Binding Id}" Click="RenameCollectionButton_OnClick" Margin="6,0,0,0" Style="{DynamicResource PlayStead.Button.Secondary}" />
                                    <Button Grid.Column="2" Content="Supprimer" Tag="{Binding Id}" Click="DeleteCollectionButton_OnClick" Margin="6,0,0,0" Style="{DynamicResource PlayStead.Button.Secondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucune collection&#xA;Créez-en une pour organiser vos jeux."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCollections}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="+ Nouvelle collection"
                            Margin="0,12,0,0"
                            Click="CreateCollectionButton_OnClick"
                            Style="{DynamicResource PlayStead.Button.Secondary}" />
                    <Button Content="Réinitialiser"
                            Style="{DynamicResource Library.FilterResetButton}"
                            Click="ResetAdvancedFiltersButton_OnClick" />
                </StackPanel>
            </Border>
        </Popup>

        <TextBlock x:Name="SteamVerificationErrorText"
                   Grid.Row="1"
                   Margin="0,10,0,10"
                   Text="{Binding SteamVerificationError}"
                   Visibility="{Binding HasSteamVerificationError, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Foreground="#D7B08C"
                   FontSize="13"
                   TextWrapping="Wrap"/>

        <ItemsControl x:Name="GameGridRows"
                      Grid.Row="2"
                      Margin="0,16,0,0"
                      ItemsSource="{Binding GridRows}"
                      Visibility="{Binding IsGridMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="GridScrollViewer"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="0,12,0,0">
                            <ItemsPresenter/>
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:GameCard SelectionRequested="GameCard_OnSelectionRequested"
                                                   DetailsRequested="GameCard_OnDetailsRequested"
                                                   MediaRequested="GameCard_OnMediaRequested"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="GameList"
                      Grid.Row="2"
                      Margin="0,16,0,0"
                      ItemsSource="{Binding VisibleItems}"
                      Visibility="{Binding IsListMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="ListScrollViewer"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid x:Name="ListHeaderRow"
                                  Margin="0,0,0,6"
                                  MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.8*" MinWidth="260" />
                                    <ColumnDefinition Width="1*" MinWidth="110" />
                                    <ColumnDefinition Width="1*" MinWidth="100" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Jeu"
                                           Style="{DynamicResource PlayStead.Text.Caption}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="Plateforme"
                                           Style="{DynamicResource PlayStead.Text.Caption}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2"
                                           Text="Taille"
                                           Style="{DynamicResource PlayStead.Text.Caption}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3"
                                           Text="Statut"
                                           Style="{DynamicResource PlayStead.Text.Caption}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <ItemsPresenter />
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ListGameRow"
                            Padding="0,0,0,8"
                            Margin="0,0,0,8"
                            Style="{DynamicResource Library.ListRow}">
                        <Grid MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*" MinWidth="260" />
                                <ColumnDefinition Width="1*" MinWidth="110" />
                                <ColumnDefinition Width="1*" MinWidth="100" />
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding InstallPath}">
                                <controls:GameArtwork Width="48"
                                                       Height="56"
                                                       Margin="0,0,12,0"
                                                       SourcePath="{Binding CoverPath}"
                                                       Title="{Binding Title}"
                                                       ProviderLabel="{Binding ProviderLabel}"
                                                       HasArtwork="{Binding HasCover}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           ToolTip="{Binding InstallPath}"
                                           Style="{DynamicResource PlayStead.Text.Body}"
                                           Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Width="24"
                                        Height="24"
                                        Margin="8,0,0,0"
                                        Padding="4"
                                        Background="{DynamicResource PlayStead.Brush.SurfaceStrong}"
                                        BorderBrush="{DynamicResource PlayStead.Brush.Copper}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource PlayStead.Radius.Small}"
                                        ToolTip="{Binding ProtectionBadgeTooltip}"
                                        Visibility="{Binding IsLocallyProtected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Stretch="Uniform"
                                          Data="M10,1 L18,4 V9 C18,14 14,18 10,20 C6,18 2,14 2,9 V4 Z"
                                          Stroke="{DynamicResource PlayStead.Brush.Copper}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          AutomationProperties.Name="Protégé par PlayStead" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProviderLabel}"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding InstalledSizeLabel, Mode=OneWay}"
                                       Style="{DynamicResource PlayStead.Text.BodySecondary}"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <controls:StatusBadge Text="{Binding SessionStatusLabel}"
                                                      Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Margin="8,0,0,0"
                                        Padding="8,3"
                                        Style="{DynamicResource Library.ListSteamStatusBadge}">
                                    <TextBlock Text="{Binding SteamStatusLabel}"
                                               Style="{DynamicResource PlayStead.Text.Caption}"
                                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Rien ne correspond à ces filtres pour l’instant."
                   Style="{DynamicResource PlayStead.Text.BodySecondary}"
                   Visibility="{Binding IsAdvancedFilterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />


        <ContentControl x:Name="GameQuickPanel"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="360"
                        Margin="20,16,0,0"
                        Panel.ZIndex="10"
                        Content="{Binding SelectedItem}"
                        Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border Padding="18"
                            Background="{DynamicResource PlayStead.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource PlayStead.Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="Black"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>



                            <Button x:Name="CloseQuickPanelButton"
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Click="CloseQuickPanelButton_OnClick"
                                        Style="{DynamicResource PlayStead.Button.Icon}"
                                        ToolTip="Fermer le panneau rapide"
                                        AutomationProperties.Name="Fermer le panneau rapide">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Text="&#xE711;"
                                               VerticalAlignment="Center"/>
                                </Button>

<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Identité / logo -->
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>



                                <Grid Grid.Row="1"
                                      Height="122"
                                      Margin="0,4,0,0">
                                    <Image Source="{Binding LogoPath}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="315"
                                           MaxHeight="108">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLogo}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="315"
                                               Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                               FontSize="20"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLogo}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Barre visuelle type Shelf -->
                                <Grid Grid.Row="2"
                                      Height="5"
                                      Margin="0,8,0,0">
                                    <Border Height="1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource PlayStead.Brush.BorderStrong}"/>
                                    <Border Width="72"
                                            Height="3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource PlayStead.Brush.Copper}"
                                            CornerRadius="2"/>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProviderLabel}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="8,3"
                                            Background="{DynamicResource PlayStead.Brush.Surface}"
                                            BorderBrush="{DynamicResource PlayStead.Brush.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding HasSteamStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SteamStatusLabel}"
                                                   Foreground="{DynamicResource PlayStead.Brush.Copper}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Jeu -->
                            <Border Grid.Row="1"
                                    Margin="0,16,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PlayStead.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PlayStead.Brush.IconAccent}"
                                                   Text="&#xE7FC;"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Jeu"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Bibliothèque"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProviderLabel}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSoft}"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Session"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="Aucune session active"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PlayStead.Brush.TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSessionActive}"
                                                                     Value="True">
                                                            <Setter Property="Text"
                                                                    Value="En cours"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PlayStead.Brush.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Border Grid.Row="3"
                                            Margin="0,10,0,0"
                                            Padding="8,5"
                                            Background="{DynamicResource PlayStead.Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource PlayStead.Brush.Copper}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Visibility="{Binding QuickPanelViewModel.HasAttention, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="À SIGNALER"
                                                   Foreground="{DynamicResource PlayStead.Brush.Copper}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.Name="À signaler"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Activité PlayStead -->
                            <Border Grid.Row="2"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PlayStead.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PlayStead.Brush.IconAccent}"
                                                   Text="&#xE823;"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Activité PlayStead"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dernière activité"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuickPanelViewModel.LastActivityLabel, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSoft}"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dernière session"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuickPanelViewModel.LastSessionDurationLabel, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSoft}"
                                                   FontSize="12"/>
                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Temps total"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuickPanelViewModel.TotalPlayTimeLabel, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"
                                                   Foreground="{DynamicResource PlayStead.Brush.Copper}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Grid.Row="4"
                                          Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Historique"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuickPanelViewModel.SessionCountLabel, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSoft}"
                                                   FontSize="12"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Installation -->
                            <Border Grid.Row="3"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PlayStead.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PlayStead.Brush.IconAccent}"
                                                   Text="&#xEDA2;"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Installation"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Taille"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding InstalledSizeLabel, Mode=OneWay}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSoft}"
                                                   FontSize="12"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="Emplacement"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                                   FontSize="12"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding InstallPath}"
                                                   Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="34"
                                                   ToolTip="{Binding InstallPath}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Depuis ta dernière partie -->
                            <Border Grid.Row="4"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PlayStead.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding QuickPanelViewModel.HasSinceLastPlaySummary, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Depuis ta dernière partie"
                                               Foreground="{DynamicResource PlayStead.Brush.TextMuted}"
                                               FontSize="12"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding QuickPanelViewModel.SinceLastPlaySummary, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"
                                               Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Collections -->
                            <Border Grid.Row="5"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PlayStead.Brush.Surface}"
                                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Collections"
                                               Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <ItemsControl Margin="0,8,0,0"
                                                  ItemsSource="{Binding CollectionOptions, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsMember, Mode=TwoWay}"
                                                          Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <controls:PlaySplitButton Grid.Row="6"
                                                      Height="42"
                                                      MaxHeight="42"
                                                      Margin="0,16,0,0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Top"
                                                      DataContext="{Binding QuickPanelViewModel.Launch, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}"/>

                            <Button x:Name="OpenGameDetailButton"
                                    Grid.Row="7"
                                    Height="42"
                                    Content="Voir la fiche"
                                    Click="OpenGameDetailButton_OnClick"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource PlayStead.Button.Secondary}"/>
                        </Grid>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleItems}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAdvancedFilterEmpty}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock x:Name="EmptyStateText"
                       Text="{Binding EmptyStateMessage, TargetNullValue=Je n’ai trouvé aucun jeu installé pour l’instant., FallbackValue=Je n’ai trouvé aucun jeu installé pour l’instant.}"
                       TextWrapping="Wrap"
                       Foreground="#A9AFB7"
                       FontSize="15"
                       HorizontalAlignment="Center"/>

            <Button x:Name="RescanButton"
                    Content="Jeter un nouvel œil"
                    Click="RescanButton_OnClick"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Style="{DynamicResource PlayStead.Button.Ghost}"/>
        </StackPanel>
    </Grid>
</UserControl>
