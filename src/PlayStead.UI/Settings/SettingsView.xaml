<UserControl x:Class="PlayStead.UI.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PlayStead.Brush.Background}"
             Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
             FontFamily="{DynamicResource PlayStead.Font.Body}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PlayStead.Spacing.4}">
            <TextBlock Text="Paramètres" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Personnalise le comportement visuel et les animations de PlayStead."
                       Foreground="{DynamicResource PlayStead.Brush.TextSecondary}"
                       TextWrapping="Wrap" Margin="0,8,0,24"/>
            <Border Background="{DynamicResource PlayStead.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayStead.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlayStead.Radius.Medium}"
                    Padding="{DynamicResource PlayStead.Spacing.3}">
                <StackPanel>
                    <CheckBox x:Name="ReduceMotionToggle"
                              Content="Réduire les animations"
                              Foreground="{DynamicResource PlayStead.Brush.TextPrimary}"
                              IsChecked="{Binding ReduceMotion, Mode=TwoWay}"/>
                    <Button x:Name="SaveSettingsButton"
                            Content="Enregistrer"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
